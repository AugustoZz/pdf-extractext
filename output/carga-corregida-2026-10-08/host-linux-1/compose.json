{
  "name": "carga-local",
  "networks": {
    "default": {
      "name": "carga-local_default",
      "ipam": {}
    }
  },
  "services": {
    "extractor": {
      "build": {
        "context": "C:\\Users\\Augusto\\Documents\\repo\\pdf-extractext\\pdf-extractext\\.test-extractor",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "uvicorn",
        "extractor_service.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--timeout-keep-alive",
        "60",
        "--no-access-log"
      ],
      "deploy": {
        "replicas": 5,
        "resources": {
          "limits": {
            "cpus": 1,
            "memory": "1073741824"
          }
        },
        "placement": {}
      },
      "entrypoint": null,
      "environment": {
        "QUEUE_TIMEOUT_S": null
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 5
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "extractor-lb": {
      "command": null,
      "depends_on": {
        "extractor": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 1,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": null,
      "image": "nginx:1.27-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\Augusto\\Documents\\repo\\pdf-extractext\\pdf-extractext\\.test-extractor\\nginx\\profesor.conf",
          "target": "/etc/nginx/nginx.conf",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "C:\\Users\\Augusto\\Documents\\repo\\pdf-extractext\\pdf-extractext\\.test-extractor\\tests\\stress\\tls",
          "target": "/etc/nginx/tls",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
