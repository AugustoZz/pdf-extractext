diff --git a/nginx/profesor.conf b/nginx/profesor.conf
new file mode 100644
index 0000000..8be2853
--- /dev/null
+++ b/nginx/profesor.conf
@@ -0,0 +1,31 @@
+worker_processes 1;
+events {
+    worker_connections 4096;
+}
+http {
+    upstream extractor {
+        zone extractor 64k;
+        least_conn;
+        server extractor:8000 max_fails=0;
+        keepalive 32;
+        keepalive_timeout 30s;
+    }
+    server {
+        listen 80;
+        listen 443 ssl;
+        server_name extract.universidad.localhost;
+        ssl_certificate /etc/nginx/tls/server.pem;
+        ssl_certificate_key /etc/nginx/tls/server.key;
+        ssl_protocols TLSv1.2 TLSv1.3;
+        ssl_session_cache shared:TLS:1m;
+        ssl_session_timeout 10m;
+        client_max_body_size 12m;
+        client_body_buffer_size 256k;
+        location / {
+            proxy_pass http://extractor;
+            proxy_http_version 1.1;
+            proxy_set_header Connection "";
+            proxy_request_buffering off;
+        }
+    }
+}
