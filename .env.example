# =============================================================
# pdf-extractext — Variables de entorno (12-Factor III: Config)
# =============================================================
# Copiar este archivo como .env y ajustar los valores:
#     cp .env.example .env
#
# El archivo .env NO se versiona (está en .gitignore).
# =============================================================

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=pdf-extractext
APP_ENV=development          # development | production | testing
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Servidor ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Base de datos (MongoDB) ──────────────────────────────────
# Con docker compose, el host es el nombre del servicio: mongodb://mongodb:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pdf_extractext

# Base usada por los tests de integración. DEBE ser distinta de MONGODB_DB_NAME:
# la suite borra la colección al empezar y al terminar.
MONGODB_TEST_DB_NAME=pdf_extractext_test

# ── Validación de PDF ────────────────────────────────────────
MAX_FILE_SIZE_MB=10
PDF_ALLOWED_MIME_TYPE=application/pdf

# URL del extractor: el valor por defecto funciona dentro de Docker Compose.
# Para desarrollo local con el balanceador publicado: http://localhost:8080/extract
EXTRACTOR_URL=http://extractor-lb/extract
EXTRACTOR_TIMEOUT_SECONDS=30

# ── Docker Compose ───────────────────────────────────────────
# Puertos del host; cambiarlos si ya están en uso en la máquina.
API_PORT=8000
MONGO_PORT=27017
EXTRACTOR_PORT=8080
EXTRACTOR_REPLICAS=5         # el TP permite hasta 5
# Para probar cambios locales del extractor: EXTRACTOR_BUILD_CONTEXT=./.test-extractor
# Si se omite, Compose construye el commit probado del fork AugustoZz/pdf-extractext-extractor.

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma.
# "*" sólo es aceptable en desarrollo; en producción declarar los dominios reales:
#     CORS_ALLOW_ORIGINS=https://mi-dominio.com,https://www.mi-dominio.com
CORS_ALLOW_ORIGINS=*
